# БАЗА И ЛЮБЫЕ ЕЁ КОПИИ НИКОГДА НЕ ЕДУТ В РЕПОЗИТОРИЙ.
# Раньше здесь были перечислены конкретные имена, и очередной бэкап
# megafon.db.before-cleanup под них не подошёл — чуть не уехал наружу
# вместе с сотней абонентских номеров. Теперь шаблон ловит всё сразу.
megafon.db*
*.db
*.sqlite
*.sqlite3
__pycache__/

# Настройки подключения к базе: в них пароль. Образец — pg.conf.example.
pg.conf

# Готовые выгрузки конвертера — их всегда можно пересоздать convert.py
otche.*.csv
*.bill.csv
*.subscribers.csv
*.services.csv
*.invoice.csv

# ═══ РАБОЧИЕ МАТЕРИАЛЫ, В РЕПОЗИТОРИЙ НЕ ЕДУТ ═══
# В репозитории лежит только то, что нужно для прода: код, установщик,
# инструменты, схема, README. Всё перечисленное ниже — черновики, снимки
# старых версий кода, образцы выгрузок и картинки-референсы. На диске они
# остаются, в архив для развёртывания не попадают.

# Снимки старых версий кода — история и так есть в git
*.py.txt
app.js.txt
code.txt
style.css.txt
tablica.txt.txt

# Черновики и описания форматов
logic.txt
prompts.txt
stolbs.txt
users.txt
vigryzka.txt
format_file_csv.txt
primer_file_for_load.txt
database.txt.txt

# Образцы выгрузок оператора — в них абонентские данные
otche.txt
otche.csv
test_*.csv
vigryzka*.txt

# Картинки-референсы и скриншоты
*.jpg
*.jpeg
*.png
# Скриншоты с телефона приезжают именно в этом формате, а под *.jpg он не
# подходит — и потому болтался в untracked, хотя это тот же самый снимок.
*.jfif

# Временные замеры отрисовки: живут ровно один прогон, в прод не едут.
_perftest.*
