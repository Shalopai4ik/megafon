# Настройки подключения к PostgreSQL.
#
# Скопировать в pg.conf рядом с приложением и поправить под свою машину.
# Файла может не быть вообще — тогда работают значения, написанные здесь.
# Переменные окружения PGHOST, PGPORT, PGDATABASE, PGUSER, PGPASSWORD
# перекрывают то, что в файле.
#
# Сам pg.conf в репозиторий не попадает: в нём пароль (см. .gitignore).

host     = 127.0.0.1
port     = 5432
database = megafon
user     = megafon
password = megafon

# Если psql не прописан в PATH, путь к нему задаётся переменной окружения
# MEGAFON_PSQL — здесь его указать нельзя, он нужен раньше, чем читается
# этот файл. Например:
#     export MEGAFON_PSQL=/usr/lib/postgresql/16/bin/psql
